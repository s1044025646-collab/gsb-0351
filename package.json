{
  "name": "gdd-tracker",
  "version": "1.0.0",
  "description": "逐时温度有效积温与阶段阈值追踪后端（TypeScript + Node.js + SQLite）",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "gdd": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --no-warnings dist/src/server.js",
    "test": "npm run build && node --no-warnings --test dist/tests/*.test.js",
    "demo": "npm run build && node --no-warnings dist/demos/demo.js",
    "cli": "npm run build && node --no-warnings dist/src/cli.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
